  "contracts":{
    "R-language":"Brace capture, special @__NOTE call, global @ rewrite, JS eval; builder-specific $ keys.",
    "R-response":"Root metadata != parsed business Field_Data; normal app/auth/matrix context required.",
    "R-parse":"Type-changing nested parsing; newly parsed strings not traversed again.",
    "R-alias":"Ordered/transitive/case-sensitive first raw block; flags do not validate evaluated results.",
    "R-text":"Nullish blank, eval error whole mixed string blank; display cleanup distinct.",
    "R-typed":"Literal falsy object members omitted, array elements kept; whole-block non-null non-string values preserved.",
    "R-list":"Raw Array<T>; list builders fallback [], then non-array fails; document_links differs.",
    "R-hide":"Only injected exact string true hides at explicitly consuming placements.",
    "R-index":"Exact [@i] table/files vs token @i list/gallery vs __EACH chips; shared retained state.",
    "R-placement":"Section[][]/Field[][]/column rows/footer[][]; modal dispatch fields then $list by shape.",
    "R-format":"Form/table date differences; currency en-US 0..2 decimals, first # only.",
    "R-modal":"Raw record/ID; <=5 rows/no ordering safe scope; page-local/sorted identity limits.",
    "R-footer":"Unindexed text, no total; first summary cell type/format governs rendering.",
    "R-files":"url/fileName/type mappings, filename inference; hide not render visibility.",
    "R-action":"Eager endpoints/messages vs lazy sanitized note/payload; consuming UI type differences.",
    "R-transport":"Primary multipart String(root value), callback JSON/header ignored/no await; workflow link render-time btoa/encodeURI.",
    "R-state":"Init replaces vars; rebuild != init; repeated/failing runs retain state; clear keeps runSetting.",
    "R-caller":"Task/history/admin/editor/mass/static contexts differ; backend selection unestablished."
  },
  "placeholderDefaults":{
